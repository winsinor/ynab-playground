# IMAP — dedicated Gmail account that receives forwarded Amazon emails
IMAP_HOST=imap.gmail.com
IMAP_USER=your-dedicated-amazon-emails@gmail.com
# Gmail App Password (Settings → Security → 2-Step Verification → App passwords)
# NOT your regular Gmail password — generate a 16-char app-specific password
IMAP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# YNAB API — https://app.ynab.com/settings/developer
YNAB_TOKEN=your-ynab-personal-access-token
# Start with a sandbox/test budget ID; swap for production in Session 6
YNAB_BUDGET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# The account ID for your Amazon Prime Visa inside the above budget
YNAB_AMAZON_ACCOUNT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Notification emails
NOTIFY_EMAIL_TO=you@example.com
# Can reuse IMAP_USER — sent via Gmail SMTP with the same app password
NOTIFY_EMAIL_FROM=your-dedicated-amazon-emails@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
